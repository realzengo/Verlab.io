{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "worker/Dockerfile",
    "watchPatterns": ["worker/**", "src/lib/client/clip-*.ts", "src/lib/clips.ts", "src/components/clipping/*.css", "public/fonts/**"]
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
