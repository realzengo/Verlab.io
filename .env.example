# Verlab environment variables. Names only: never commit real values.
# Copy to .env.local for local development; set the same names in Vercel
# (and in Railway for the clip render worker).

# --- Supabase (auth, database, storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Worker only: same value as NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=

# --- Signup & checkout fraud protection (see src/lib/server/abuse-guards.ts) ---
# Cloudflare Turnstile. Leave both empty to switch Turnstile off -- and if you
# do, also turn CAPTCHA off in Supabase (Authentication > Bot and Abuse
# Protection), or sign-ups and sign-ins without a token will be rejected.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Secret of the Supabase "Before User Created" HTTPS hook, as shown in the
# dashboard ("v1,whsec_..."). Hook URL: https://app.verlab.io/api/auth/before-user-created
SUPABASE_AUTH_HOOK_SECRET=
# Set to 1 to let every sign-up through the hook without checks.
SIGNUP_GUARD_DISABLED=
# Set to 1 to skip the confirmed-email check and rate limits at checkout.
CHECKOUT_GUARDS_DISABLED=

# --- Payments ---
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
WHOP_CHECKOUT_SUCCESS_URL=
WHOP_PLAN_CORE_MONTHLY=
WHOP_PLAN_CORE_YEARLY=
WHOP_PLAN_PRO_MONTHLY=
WHOP_PLAN_PRO_YEARLY=
WHOP_PLAN_SCALE_MONTHLY=
WHOP_PLAN_SCALE_YEARLY=
WHOP_PLAN_CREDITS_500=
WHOP_PLAN_CREDITS_1000=
WHOP_PLAN_CREDITS_3000=
WHOP_PLAN_CREDITS_10000=

# --- Email (failed-payment notices) ---
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Verlab <billing@verlab.io>".
# Replies go to verlabcontact@gmail.com (set in code).
RESEND_FROM_EMAIL=

# --- AI and model providers ---
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
REPLICATE_API_TOKEN=
FAL_API_KEY=
ELEVENLABS_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Video and creator data ---
SCRAPECREATORS_API_KEY=
SOCIAVAULT_API_KEY=
APIFY_API_TOKEN=
YOUTUBE_API_KEY=
# video-download-api.com: fetches the YouTube source for AI clipping only.
# (The user-facing video downloader was removed.)
SAVENOW_API_KEY=

# --- Analytics ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- App ---
ADMIN_EMAILS=
CRON_SECRET=
MCP_THUMB_PROXY_SECRET=
# Clip rendering (server render on/off, queue sizes) -- optional tuning
CLIP_SERVER_RENDER=
CLIP_RENDER_QUEUE_LIMIT=
CLIP_PREPARE_CONCURRENCY=
CLIP_SOURCE_CONCURRENCY=
CLIP_WORKER_CONCURRENCY=

# --- Render worker (Railway) only ---
CHROME_PATH=
CHROME_NO_SANDBOX=
CHROME_EXTRA_ARGS=
FONTS_DIR=
